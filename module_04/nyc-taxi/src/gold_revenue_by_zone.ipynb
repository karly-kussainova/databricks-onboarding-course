<cell id="cell-0">from pyspark.sql import SparkSession
from pyspark.sql.functions import col, count, avg, sum as fsum, to_date, lit


spark = SparkSession.builder.getOrCreate()</cell id="cell-0">
<cell id="cell-1">dbutils.widgets.text("catalog", "new_york_taxi")
dbutils.widgets.text("silver_schema", "silver")
dbutils.widgets.text("gold_schema", "gold")

CATALOG       = dbutils.widgets.get("catalog")
SILVER_SCHEMA = dbutils.widgets.get("silver_schema")
GOLD_SCHEMA   = dbutils.widgets.get("gold_schema")</cell id="cell-1">
<cell id="cell-2"># 1. Read silver tables
trips_all = spark.table(f"{CATALOG}.{SILVER_SCHEMA}.trips_all")
dim_taxi_zone = spark.table(f"{CATALOG}.{SILVER_SCHEMA}.dim_taxi_zone")</cell id="cell-2">
<cell id="cell-3"># 2. Join trips with zone dimension and aggregate by borough and zone
revenue_by_zone = (
    trips_all
    .join(
        dim_taxi_zone,
        col("pickup_location_id") == col("location_id"),
        "left"
    )
    .groupBy(col("borough"), col("zone"))
    .agg(
        count("*").alias("total_trips"),
        fsum("total_amount").alias("total_revenue"),
        avg("fare_amount").alias("avg_fare"),
        avg("tip_amount").alias("avg_tip"),
        avg("trip_distance").alias("avg_distance")
    )
    .orderBy(col("total_revenue").desc())
)</cell id="cell-3">
<cell id="cell-4">revenue_by_zone.write.mode("overwrite").saveAsTable(f"{CATALOG}.{GOLD_SCHEMA}.revenue_by_zone")</cell id="cell-4">